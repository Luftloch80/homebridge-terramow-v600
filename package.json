{
  "name": "homebridge-terramow-v600",
  "displayName": "TerraMow V600",
  "type": "module",
  "version": "1.2.0",
  "description": "Homebridge plugin for TerraMow V600. Exposes a Fanv2 vacuum-style HomeKit accessory with battery, maintenance filters, and status sensors over local MQTT.",
  "author": "Alexander Droste",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Luftloch80/homebridge-terramow-v600#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luftloch80/homebridge-terramow-v600.git"
  },
  "bugs": {
    "url": "https://github.com/Luftloch80/homebridge-terramow-v600/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homebridge-ui",
    "terramow",
    "v600",
    "lawn-mower",
    "robot-mower",
    "mqtt"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "homebridge-ui",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": "^18.20.0 || ^20.15.1 || ^22 || ^24",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "clean": "rimraf ./dist",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.5",
    "mqtt": "^5.10.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "homebridge": "^1.9.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  }
}
