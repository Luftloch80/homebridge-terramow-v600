{
  "pluginAlias": "TerraMowV600",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "strictValidation": false,
  "headerDisplay": "<strong>Native vacuum icon requires Matter.</strong> Enable a Child Bridge, turn on Matter for that bridge, restart, remove any old Fan in Apple Home, then pair with the <em>mower</em> code from logs (<code>Commissioning codes for …</code>) — not the bridge code. Wrong code → PASE / pairing errors.",
  "footerDisplay": "Username is fixed as <code>terramow</code>. Mode defaults to Matter (no Fan tile). Set mode to Fan only if you cannot enable Matter.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "TerraMow",
        "required": true
      },
      "mode": {
        "title": "Apple Home Presentation",
        "type": "string",
        "default": "matter",
        "oneOf": [
          {
            "title": "Native vacuum (Matter) — required for vacuum icon",
            "enum": ["matter"]
          },
          {
            "title": "Fan fallback (classic HomeKit / no Matter)",
            "enum": ["hap"]
          }
        ],
        "description": "Matter must be enabled on the bridge that runs this plugin (usually its child bridge)."
      },
      "mowers": {
        "title": "Mowers",
        "type": "array",
        "required": true,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Display Name",
              "type": "string",
              "default": "TerraMow V600",
              "required": true
            },
            "host": {
              "title": "Mower IP / Hostname",
              "type": "string",
              "default": "",
              "required": true,
              "placeholder": "192.168.1.50"
            },
            "password": {
              "title": "MQTT Password",
              "type": "string",
              "default": "",
              "required": true,
              "format": "password"
            },
            "port": {
              "title": "MQTT Port",
              "type": "integer",
              "default": 1883,
              "minimum": 1,
              "maximum": 65535
            },
            "lowBatteryThreshold": {
              "title": "Low Battery Threshold (%)",
              "type": "integer",
              "default": 20,
              "minimum": 5,
              "maximum": 50
            }
          }
        }
      }
    }
  }
}
