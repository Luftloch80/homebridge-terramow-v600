{
  "pluginAlias": "TerraMowV600",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "strictValidation": false,
  "headerDisplay": "Control TerraMow V600 (and other TerraMow models) over the local MQTT Home Assistant interface. Enable Home Assistant in the TerraMow app to get the MQTT password.",
  "footerDisplay": "Username is fixed as <code>terramow</code>. Need help? See the <a href=\"https://github.com/Luftloch80/homebridge-terramow-v600\" target=\"_blank\">plugin README</a>.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "TerraMow",
        "required": true,
        "description": "Internal Homebridge platform name."
      },
      "mowers": {
        "title": "Mowers",
        "type": "array",
        "required": true,
        "description": "Add one entry per TerraMow on your network.",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Display Name",
              "type": "string",
              "default": "TerraMow V600",
              "required": true,
              "description": "Name shown in HomeKit."
            },
            "host": {
              "title": "Mower IP / Hostname",
              "type": "string",
              "default": "",
              "required": true,
              "placeholder": "192.168.1.50",
              "description": "Local IP from TerraMow app → device info."
            },
            "password": {
              "title": "MQTT Password",
              "type": "string",
              "default": "",
              "required": true,
              "format": "password",
              "description": "Shown in the TerraMow app after enabling Home Assistant."
            },
            "port": {
              "title": "MQTT Port",
              "type": "integer",
              "default": 1883,
              "minimum": 1,
              "maximum": 65535,
              "description": "Usually 1883."
            },
            "lowBatteryThreshold": {
              "title": "Low Battery Threshold (%)",
              "type": "integer",
              "default": 20,
              "minimum": 5,
              "maximum": 50
            },
            "showPauseSwitch": {
              "title": "Show Pause Switch",
              "type": "boolean",
              "default": true
            },
            "showDockSwitch": {
              "title": "Show Dock Switch",
              "type": "boolean",
              "default": true
            },
            "showSensors": {
              "title": "Show Status Sensors",
              "type": "boolean",
              "default": true,
              "description": "At Base, Returning, Fault, and Rain Delay contact sensors."
            }
          }
        }
      }
    }
  }
}
